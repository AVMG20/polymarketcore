{
  "name": "polymarketcore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun nuxt dev --port 3100",
    "build": "bun --bun nuxt build",
    "preview": "PORT=3100 bun .output/server/index.mjs",
    "postinstall": "bun --bun nuxt prepare",
    "typecheck": "bun --bun nuxt typecheck",
    "test": "bun --bun vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun scripts/seed.ts"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "h3": "1.15.11",
    "jose": "^6.2.18",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.6.4",
    "pg": "^8.23.1",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "^2.9.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "imports": {
    "#server/*": "./server/*",
    "#shared/*": "./shared/*"
  }
}
