# ─── Local development ───────────────────────────────────────────────────────
# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgres://pnxcore:pnxcore@localhost:5433/pnxcore

# better-auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3100

# Public URL of the hub: launch token issuer (`iss`) and absolute links. Defaults to BETTER_AUTH_URL.
# Production refuses to start without one of the two.
CORE_URL=http://localhost:3100

# Dev seed only (`bun run db:seed`, never in production): the casino's API key, equal to PNX_APP_KEY in polymarketcasino/.env
SEED_CASINO_APP_KEY=pnx_dev_casino_key_change_me

# Comma-separated emails that are admins regardless of their role column
ADMIN_EMAILS=dev@polynux.local

# Optional: extra origins allowed to call the auth API (comma-separated)
# TRUSTED_ORIGINS=

# Optional: Discord login is only enabled when both are set
BETTER_AUTH_DISCORD_CLIENT_ID=
BETTER_AUTH_DISCORD_CLIENT_SECRET=

# Optional: a fixed ES256 private JWK (JSON) for launch tokens instead of the DB-stored key
# PNX_SIGNING_JWK=

# Optional: Postgres pool size per process (default 20)
# DATABASE_POOL_MAX=20

# Optional: first-party apps created on server start, verified and without an owner (admins manage them).
# A JSON array of { id, name, baseUrl, returnUrlPrefixes?, key }; key is the app's PNX_APP_KEY
# (pnx_ + at least 24 characters: echo "pnx_$(openssl rand -hex 32)"), stored only as a hash.
# Existing apps are never changed (rotate or edit them on /admin/apps). Invalid JSON stops the server.
# BOOTSTRAP_APPS=[{"id":"casino","name":"Polynux Casino","baseUrl":"http://localhost:3200","key":"pnx_…"}]

# Optional: error tracking in Rustrak (Sentry-compatible), browser and server. Off when empty.
# NUXT_PUBLIC_SENTRY_DSN=https://<key>@rustrak.bitploy.nl/1
# NUXT_PUBLIC_SENTRY_ENVIRONMENT=                (default: development in dev, production otherwise)
# Build only: upload browser source maps (a Rustrak API token with source-maps:create; in Docker a build secret)
# SENTRY_AUTH_TOKEN=

# Tests only: the database the tests create and migrate (default: DATABASE_URL's database + _test)
# TEST_DATABASE_URL=

# ─── Production (core.avmg.nl) ───────────────────────────────────────────────
# NODE_ENV=production                         (set by the Dockerfile)
# HOST=0.0.0.0  PORT=3000                     (set by the Dockerfile)
# DATABASE_URL=postgres://pnxcore:<password>@<db-host>:5432/pnxcore
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# BETTER_AUTH_URL=https://core.avmg.nl        (https => Secure cookies)
# CORE_URL=https://core.avmg.nl
# ADMIN_EMAILS=<your email>                  (sign that account up right after the first deploy: whoever
#                                             registers a listed email first is admin, emails aren't verified)
# BOOTSTRAP_APPS=[{"id":"casino","name":"Polynux Casino","baseUrl":"https://casino.avmg.nl","key":"pnx_<64 hex>"}]
#                                             (the same key goes into the casino's PNX_APP_KEY)
# NUXT_PUBLIC_SENTRY_DSN=https://9c47e769c2464171a2c666e32ebf0b14@rustrak.bitploy.nl/1
# SENTRY_AUTH_TOKEN=<Rustrak API token>       (hidden; read by the build to upload browser source maps)
# Do NOT set SEED_CASINO_APP_KEY and never run the seed.
